{
  "name": "modbus_simple_logger",
  "version": "7.3.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx vite dev",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test tests",
    "typecheck:launcher": "bunx tsc -p tsconfig.launcher.json --noEmit",
    "build": "bun run typecheck && bunx vite build",
    "preview": "bunx vite preview",
    "deploy": "bun run build && bun run scripts/deploy-gh-pages.ts",
    "launcher:dev": "bun run build && bun run launcher/generate-embed.ts && bun run typecheck:launcher && bun run launcher/main.ts",
    "launcher:build": "bun run build && bun run launcher/generate-embed.ts && bun run typecheck:launcher && bun run launcher/build.ts"
  },
  "dependencies": {
    "@fontsource/iosevka": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "plotly.js": "^4.3.0",
    "prismjs": "^1.30.0",
    "pyodide": "^314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-plotly.js": "^4.1.0",
    "react-rnd": "^10.5.3",
    "react-simple-code-editor": "^0.14.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/plotly.js": "^3.0.15",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
