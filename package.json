{
  "name": "modbus_simple_logger",
  "version": "7.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx vite dev",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:launcher": "bunx tsc -p tsconfig.launcher.json --noEmit",
    "build": "bun run typecheck && bunx vite build",
    "preview": "bunx vite preview",
    "deploy": "bun run build && bun run scripts/deploy-gh-pages.ts",
    "launcher:dev": "bun run build && bun run launcher/generate-embed.ts && bun run typecheck:launcher && bun run launcher/main.ts",
    "launcher:build": "bun run build && bun run launcher/generate-embed.ts && bun run typecheck:launcher && bun run launcher/build.ts"
  },
  "dependencies": {
    "@fontsource/iosevka": "^5.3.0",
    "plotly.js": "^3.7.0",
    "prismjs": "^1.30.0",
    "pyodide": "^314.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plotly.js": "^4.1.0",
    "react-rnd": "^10.5.3",
    "react-simple-code-editor": "^0.14.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/plotly.js": "^3.0.13",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
